# Banco de dados (PostgreSQL 15+ em produção; o padrão local é SQLite para desenvolvimento)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/politica_transparente

# Chave usada para assinar os tokens JWT — troque em produção
SECRET_KEY=troque-esta-chave-em-producao

# Validade do token de acesso, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Timeout (segundos) da verificação HTTP do link da fonte de uma promessa
FONTE_HTTP_TIMEOUT=5

# Opcional: cria um usuário moderador no primeiro start, se ainda não existir
# ADMIN_EMAIL=admin@politicatransparente.org
# ADMIN_SENHA=senha-forte-aqui
